# Copie para .env.local (fora do git) e preencha o que precisar.

# Mapa do dashboard (Operação › Dashboard), fundo "Satélite": chave (API key) da conta
# gratuita da Esri — ArcGIS Location Platform (https://location.arcgis.com), com permissão
# de Basemaps. Restrinja a chave ao endereço do sistema (referrer). Sem a chave, o botão
# "Satélite" não aparece; "Limpo" e "Cinza" usam o OpenStreetMap.
VITE_ESRI_API_KEY=

# Outro provedor de tiles para os mapas (opcional; padrão: OpenStreetMap).
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILES_ATTRIBUTION=&copy; OpenStreetMap

# Demonstração sem backend (API simulada).
# VITE_USE_MOCKS=true
