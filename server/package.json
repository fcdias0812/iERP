{
  "name": "ierp-server",
  "private": true,
  "version": "0.1.0",
  "description": "Backend do Re-Teck iERP — API REST (Express) com banco SQLite via Kysely (preparado para PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:desfazer": "tsx src/db/cli.ts desfazer",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "kysely": "0.29.7",
    "multer": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
