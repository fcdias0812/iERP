{
  "name": "reteck-ierp",
  "private": true,
  "version": "0.1.0",
  "description": "Re-Teck iERP (versão 2) — ERP de logística reversa. Frontend (React) na raiz; backend (Express + SQLite) em server/.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/generate-palette.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run",
    "test:api": "npm --prefix server test",
    "test:watch": "vitest",
    "check:colors": "node scripts/check-colors.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
